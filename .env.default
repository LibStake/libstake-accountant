# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 gitignore — 커밋 금지)
# .env.default 는 키 목록만 문서화하는 플레이스홀더입니다. 시크릿을 넣지 마세요.

# ===== Firebase =====
# 서비스 계정 JSON(한 줄). 로컬은 여기에 작은따옴표로 감싸 넣습니다.
# Vercel 입력칸에는 따옴표 없이 JSON 본문만 붙여넣으세요.
FIREBASE_SERVICE_ACCOUNT=

# Firestore 규칙/인덱스 배포용 CI 토큰 (`npx firebase login:ci`). Vercel 에는 불필요.
FIREBASE_TOKEN=

# ===== 앱 로그인 (단일 사용자) =====
OWNER_EMAIL=

# 비밀번호 / PIN 의 PBKDF2 해시 — scripts/hash-credential.mjs 로 생성합니다.
AUTH_PASSWORD_HASH=
AUTH_PIN_HASH=
